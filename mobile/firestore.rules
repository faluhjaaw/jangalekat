rules_version = '2';

// Un enseignant authentifie ne peut lire/ecrire que son propre sous-arbre
// enseignants/{uid}/** (classes, eleves, notes, messages). Rien n'est public.
// Exception : le back-office admin (admin/, voir sa fonction isAdmin ci-
// dessous) peut lire tous les sous-arbres et modifier le profil enseignant.
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin back-office : compte provisionne manuellement (console Firebase,
    // pas de self-service) en creant `admins/{uid}` avec le meme uid que le
    // compte Firebase Auth. Pas de custom claims (necessiteraient l'Admin
    // SDK / une Cloud Function, hors scope "pas de backend" du MVP).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /enseignants/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      // Le champ email du profil doit toujours correspondre a l'identite
      // reelle du compte Firebase Auth (email/mot de passe) : empeche un
      // enseignant d'ecrire une adresse divergente dans son propre document.
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.email == request.auth.token.email;
      // L'admin peut modifier le profil (ex. poser `actif: false` pour
      // desactiver un compte) sans passer par la contrainte email ci-dessus,
      // qui ne s'applique qu'au proprietaire du document.
      allow update: if isAdmin();

      match /{document=**} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Verrou a distance pour les builds de test (voir ReleaseGateService) :
    // lu avant meme la connexion (ecran de login inclus), donc public en
    // lecture. Ecriture reservee a l'admin (console/Admin SDK), jamais
    // depuis l'app.
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Boite a suggestions : tout enseignant authentifie peut deposer une
    // recommandation, mais aucun ne peut lire/modifier celles des autres —
    // seule l'equipe back-office y accede (Admin SDK, hors regles).
    match /recommandations/{id} {
      allow create: if request.auth != null &&
        request.resource.data.enseignantUid == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
